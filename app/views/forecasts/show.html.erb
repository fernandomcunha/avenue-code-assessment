<% content_for :title, "ZIP Forecast" %>

<main class="forecast-page">
  <header class="page-header">
    <h1>ZIP Forecast</h1>
    <p class="subtitle">Enter a US address or ZIP code for the current temperature and 7-day outlook.</p>
  </header>

  <%= form_with url: forecast_path, method: :get, local: true, class: "lookup-form" do |form| %>
    <div class="field-group">
      <%= form.label :address, "Address or ZIP code" %>
      <div class="input-row">
        <%= form.text_field :address, value: @address, placeholder: "e.g. 1 Apple Park Way, Cupertino, CA or 95014", autofocus: true %>
        <%= form.submit "Get forecast" %>
      </div>
    </div>
  <% end %>

  <% if @error_message.present? %>
    <div class="error-message" role="alert">
      <%= @error_message %>
    </div>
  <% end %>

  <% if @result %>
    <%= render "result", result: @result %>
  <% end %>
</main>
